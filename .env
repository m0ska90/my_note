# MAX Messenger Bot Receiver - Environment Variables
# =========================================

# Токен бота MAX (или используйте --configure-token)
MAX_BOT_TOKEN=your_max_bot_token_here

# Путь к CA сертификату для platform-api2.max.ru
MAX_ROOT_CA_PATH=C:\Users\Ilya\Python_Project\my_note\russian_trusted_root_ca.pem

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Порт для health check endpoint (0 = отключено)
HEALTH_PORT=8080
