{
    "api": {
        "base_url": "https://platform-api2.max.ru",
        "rate_limit_rps": 30,
        "min_poll_interval_ms": 300,
        "long_poll_timeout": 30,
        "max_message_length": 4000,
        "max_attachments_per_message": 12,
        "max_buttons_per_keyboard": 210,
        "max_buttons_per_row": 7
    },
    "database": {
        "journal_mode": "WAL",
        "busy_timeout_ms": 10000,
        "notes_dir": "%APPDATA%/MyNotesApp"
    },
    "retry": {
        "attachment_not_ready_max_retries": 3,
        "attachment_not_ready_backoff_seconds": 2,
        "error_backoff_max_seconds": 60
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s",
        "date_format": "%Y-%m-%d %H:%M:%S"
    },
    "health_check": {
        "enabled": false,
        "host": "127.0.0.1",
        "port": 8080,
        "endpoint": "/health"
    },
    "bot": {
        "allowed_chat_ids": []
    }
}